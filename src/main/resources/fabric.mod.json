{
    "schemaVersion": 1,
    "id": "vertexai",
    "version": "${version}",
    "name": "Vertex AI Utility",
    "description": "An AI-powered utility mod with auto-responder and path visualizer.",
    "authors": [
        "Me!"
    ],
    "contact": {
        "homepage": "https://fabricmc.net/",
        "sources": "https://github.com/FabricMC/fabric-example-mod"
    },
    "license": "CC0-1.0",
    "icon": "assets/vertexai/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.vertexai.VertexAIMod"
        ],
        "client": [
            "com.vertexai.client.VertexAIModClient",
            "com.vertexai.VertexClient"
        ]
    },
    "mixins": [
        {
            "config": "vertexai.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.16.5",
        "minecraft": "*",
        "java": ">=21",
        "fabric-api": "*"
    }
}